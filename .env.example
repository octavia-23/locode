# Locode Environment Configuration
# Copy this file to .env or ~/.locode/.env and insert your API keys

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=""

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=""

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=""

# Optional defaults:
# LOCODE_PROVIDER="gemini"
# LOCODE_MODEL="gemini-3.8-flash"
